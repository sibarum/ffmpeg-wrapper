<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>sibarum.ffmpeg</groupId>
    <artifactId>ffmpeg-wrapper</artifactId>
    <version>0.1.1-SNAPSHOT</version>

    <name>ffmpeg-wrapper</name>
    <description>
        Panama (FFM) bindings for one C ABI over every video FFmpeg decodes: H.264, HEVC, VP8, VP9,
        AV1 and the rest, in MP4, MKV, WebM, MOV and the rest, each frame as RGBA8 at the size asked
        for. Hand-written downcalls over a sixteen-function header (native/include/ffwrap.h) and a
        small C shim behind it, so FFmpeg's structs never cross into Java — no jextract, no JNI. The
        shim is built in native/ (see native/build.sh) against a pinned LGPL shared FFmpeg, and both
        are bundled into the jar from native/dist/bin at package time; at runtime they are extracted
        to a temp dir and loaded.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Bundle the native build output (not committed to git) into the jar, keeping the
                 per-platform directory names build.sh stages into and NativeLib.java reads back. -->
            <resource>
                <directory>native/dist/bin</directory>
                <targetPath>natives</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <target>${maven.compiler.release}</target>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
