<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>sibarum.ffmpeg</groupId>
    <artifactId>ffmpeg-wrapper-parent</artifactId>
    <version>0.1.2</version>
    <packaging>pom</packaging>

    <name>ffmpeg-wrapper-parent</name>
    <description>
        Video through FFmpeg, as modules: ffmpeg-wrapper (the Java API, holding no platform knowledge), and one
        ffmpeg-wrapper-&lt;os&gt; module per operating system with that OS's build of the ffwrap shim and the
        FFmpeg libraries under it. The shim's C source is shared, in native/; each OS module builds it with its own
        native/build.sh. Recording is the same again, apart: ffmpeg-wrapper-record and one
        ffmpeg-wrapper-record-&lt;os&gt; module per OS, with the ffrecord shim over an FFmpeg holding only the AV1
        encoders.
    </description>

    <modules>
        <!-- Where an OS module's libraries are, as an interface the facade and the OS modules share. -->
        <module>ffmpeg-wrapper-api</module>
        <!-- The OS halves: each bundles only its own platform's libraries. ffmpeg-wrapper's profiles add one. -->
        <module>ffmpeg-wrapper-windows</module>
        <module>ffmpeg-wrapper-linux</module>
        <!-- The library vexelray-codec depends on, under the artifactId it already names. -->
        <module>ffmpeg-wrapper</module>
        <!-- Recording, apart down to its own FFmpeg (the AV1 encoders only, built from source by each OS module's
             native/build.sh), so an application that only records carries no decoder. -->
        <module>ffmpeg-wrapper-record-windows</module>
        <module>ffmpeg-wrapper-record-linux</module>
        <module>ffmpeg-wrapper-record</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>sibarum.ffmpeg</groupId>
                <artifactId>ffmpeg-wrapper-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.ffmpeg</groupId>
                <artifactId>ffmpeg-wrapper-windows</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.ffmpeg</groupId>
                <artifactId>ffmpeg-wrapper-linux</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.ffmpeg</groupId>
                <artifactId>ffmpeg-wrapper</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.ffmpeg</groupId>
                <artifactId>ffmpeg-wrapper-record-windows</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.ffmpeg</groupId>
                <artifactId>ffmpeg-wrapper-record-linux</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Platform-specific code only in -windows, -linux and -macos modules: vexelray-build's isolate goal fails
                 the build on any outside them (vexelray-build/README.md). -->
            <plugin>
                <groupId>dev.vexelray.build</groupId>
                <artifactId>vexelray-build-maven-plugin</artifactId>
                <version>0.1.2</version>
                <executions>
                    <execution>
                        <id>isolate</id>
                        <goals>
                            <goal>isolate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <!-- On Linux the build goes to target-linux/, not target/: the Windows host and a Linux VM build the same checkout
             (a shared folder), and each keeps its own output beside the other's instead of overwriting it. -->
        <profile>
            <id>linux-build-output</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                </os>
            </activation>
            <build>
                <directory>${project.basedir}/target-linux</directory>
            </build>
        </profile>
    </profiles>
</project>
